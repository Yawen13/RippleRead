# ── RippleRead Environment ──
# Copy to .env and fill in your values.

# DeepSeek API key (required for AI features)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# JWT signing secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=generate-a-random-secret-at-least-32-chars

# Database path (leave default for SQLite)
DB_PATH=rippleread.db

# Server
HOST=127.0.0.1
PORT=8001

# GitHub deploy webhook secret (optional)
DEPLOY_SECRET=change-me
