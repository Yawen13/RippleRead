# ── RippleRead Production ──
# Copy this file to .env and fill in your values.

# DeepSeek API key (required)
DEEPSEEK_API_KEY=sk-your-key-here

# JWT signing secret (generate: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me-to-a-random-64-char-string

# Database path (default, mounted docker volume)
DB_PATH=/app/data/rippleread.db

# GitHub webhook secret (for auto-deploy, required)
# Use the SAME secret in GitHub Settings → Secrets → DEPLOY_SECRET
DEPLOY_SECRET=change-me-to-another-random-string

# Domain
DOMAIN=rippleread.me
